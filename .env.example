DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bd_copeba_tickets
DB_USER=tickets_app
DB_PASSWORD=
# Base en la nube (TiDB Cloud): DB_PORT=4000, DB_SSL=1 y la ruta de los certificados raíz.
# En Laragon: C:\laragon\etc\ssl\cacert.pem   (en local dejar DB_SSL vacío)
DB_SSL=
DB_SSL_CA=

CHAT_API_URL=
CHAT_API_TOKEN=

# Contacto de Informática que muestra el login en "¿Olvidaste tu contraseña?" (opcionales)
SOPORTE_CORREO=
SOPORTE_TELEFONO=
SOPORTE_EXTENSION=

# Correo SMTP para avisos de tickets (si se dejan vacíos, no se envían correos)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Copeba Tickets
