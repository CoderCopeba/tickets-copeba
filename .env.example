DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_NAME=bd_copeba_tickets
DB_USER=PREFIJO.tickets_app
DB_PASSWORD=
# Base compartida en la nube (TiDB Cloud). PREFIJO, DB_USER y DB_PASSWORD los entrega
# Informática en persona. Sin internet (base local opcional): DB_HOST=127.0.0.1,
# DB_PORT=3306, DB_USER=tickets_app y DB_SSL vacío.
DB_SSL=1
DB_SSL_CA=C:\laragon\etc\ssl\cacert.pem
# APP_URL=   (opcional; solo en un servidor. En Laragon la dirección se calcula sola)

CHAT_API_URL=
CHAT_API_TOKEN=

# Contacto de Informática que muestra el login en "¿Olvidaste tu contraseña?" (opcionales)
SOPORTE_CORREO=
SOPORTE_TELEFONO=
SOPORTE_EXTENSION=

# Correo SMTP para avisos de tickets (si se dejan vacíos, no se envían correos)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Copeba Tickets
