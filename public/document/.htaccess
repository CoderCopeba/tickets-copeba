# Carpeta de adjuntos de tickets.
# Fase 3: NINGÚN acceso HTTP directo. Los archivos se sirven solo a través de
# controller/documento.php?op=ver&doc_id=N, que comprueba sesión y permisos.
Require all denied

# Defensa adicional por si el bloqueo anterior se desactivara: nunca ejecutar nada.

# Sin listado de directorios ni CGI
Options -Indexes -ExecCGI

# No tratar ningún archivo como script
RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .phar .pl .py .cgi .sh .asp .aspx .jsp .shtml
RemoveType .php .php3 .php4 .php5 .php7 .php8 .phtml .phar

# Apagar el intérprete PHP en esta carpeta (mod_php)
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule php_module>
    php_flag engine off
</IfModule>

# Bloquear por completo extensiones ejecutables y archivos ocultos (.htaccess, etc.)
<FilesMatch "(?i)\.(php\d?|phtml|phar|pl|py|cgi|sh|asp|aspx|jsp|shtml|htaccess|htpasswd|exe|bat|cmd|ps1|js|html?|svg)$">
    Require all denied
</FilesMatch>
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Evitar que el navegador "adivine" el tipo y ejecute contenido
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
